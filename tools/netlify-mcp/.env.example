# Netlify personal access token. Server-side only; never expose to the HLC browser app.
NETLIFY_AUTH_TOKEN=

# Lock this MCP server to exactly one Netlify site.
# HLC site/project: glittery-pavlova-0f33bd
# Use the site's immutable Netlify site ID here, not a domain name.
NETLIFY_SITE_ID=

# Optional bearer token protecting the MCP endpoint itself.
MCP_SHARED_SECRET=

# Safety interlock. Keep false for normal HLC use.
# When false, netlify_trigger_branch_build refuses the site's production branch.
ALLOW_PRODUCTION_ACTIONS=false
